# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to git — it contains secrets.

# ── Required ──────────────────────────────────────────────────────────────────

# Flask secret key — must be at least 32 random characters
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-character-string

# PostgreSQL password for the eyemeeye database user
POSTGRES_PASSWORD=replace-with-a-strong-password

# SMTP email settings — required for account verification, login OTP, and password reset
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SENDER=noreply@yourdomain.com

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Request rate limit per IP address
RATE_LIMIT=100/hour

# Set to true when TLS is terminated at nginx (enables HSTS and Secure cookies)
ENABLE_HTTPS=false

# Host port nginx listens on
PORT=80
